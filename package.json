{
  "name": "school-management-mern",
  "private": true,
  "version": "1.4.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "seed:plans": "npm run seed:plans -w apps/api",
    "seed:demo": "npm run seed:demo -w apps/api",
    "smoke": "npm run smoke -w apps/api",
    "test": "npm test -w apps/api",
    "build": "npm run build -w apps/web",
    "check": "npm test && npm run build",
    "verify": "node scripts/verify.js",
    "verify:quick": "node scripts/verify.js --quick",
    "backup": "npm run backup -w apps/api",
    "restore": "npm run restore -w apps/api --",
    "plans:price": "npm run plans:price -w apps/api --",
    "security:audit": "npm audit --omit=dev",
    "security:full": "npm audit"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "postcss-selector-parser": "^7.1.6",
    "uuid": "^11.1.1",
    "shell-quote": "^1.12.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "dependencies": {
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2"
  }
}
