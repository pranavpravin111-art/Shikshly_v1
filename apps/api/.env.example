# Copy to apps/api/.env  (or just run: npm run setup)
NODE_ENV=development
API_PORT=4000
# Local Docker database (npm run db:up). In production use MongoDB Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/shikshly?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-long-random-secret-value
PLATFORM_ADMIN_BOOTSTRAP_SECRET=replace-with-another-long-random-value
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
APP_WEB_URL=http://localhost:5173
TRUST_PROXY=false
DB_TRANSACTIONS=true
# Optional integrations (leave empty until you need them)
MSG91_AUTH_KEY=
MSG91_ATTENDANCE_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email for password reset + email confirmation.
# Development: leave as "console" (emails are printed in the API log and saved in apps/api/.mail-outbox.jsonl).
# Production: MAIL_PROVIDER=resend, a free key from https://resend.com, and a sender on your verified domain.
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=Shikshly <no-reply@your-domain.com>
# Leave empty: confirmation is required in production, off in development.
REQUIRE_EMAIL_VERIFICATION=
# Optional but recommended in production: a Slack / Discord / Google Chat "incoming webhook" address.
# The API sends a short message there when the server has an error, so you hear about problems on your phone.
ALERT_WEBHOOK_URL=
